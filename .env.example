# HELIX Phase 0+ Authentication Configuration
# Copy this file to .env.local and fill in the values

# Server Configuration
NODE_ENV=development
APP_PORT=3001
APP_NAME=HELIX
BASE_URL=http://localhost:8080

# Security
JWT_SECRET=change-me-to-a-secure-random-string

# Database (optional - uses memory store by default)
DATABASE_URL=
HELIX_STORAGE_PATH=.data/helix-state.json

# Executable workspaces and sandboxed execution
# Project files are materialized here and run inside an isolated sandbox.
# Requires Linux with bubblewrap (bwrap) and /usr/bin/prlimit; execution is
# disabled with a clear status when either is missing.
HELIX_WORKSPACE_ROOT=.data/workspaces
# EXECUTION_MAX_CONCURRENT=2                  # sandboxed jobs running at once (1-8 per instance)

# Email Configuration
# Options: 'demo' (logs to console), 'smtp', 'sendgrid'
EMAIL_PROVIDER=demo
EMAIL_FROM=noreply@helix.app

# SMTP Email Configuration (when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false

# SendGrid Email Configuration (when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=your-sendgrid-api-key

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# GitHub OAuth Configuration
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here

# GitHub export from the workspace (optional; uses the Git Data API)
# HELIX_GITHUB_TOKEN=ghp_your_personal_access_token
# GITHUB_API_BASE_URL=https://api.github.com

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3001
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
VITE_GITHUB_CLIENT_ID=your-github-client-id-here
# Cookie-session mode (build time; pair with HELIX_COOKIE_SESSIONS=true).
# When enabled the frontend keeps no token in localStorage; requests
# authenticate via the httpOnly session cookie (credentials: include).
# VITE_COOKIE_SESSIONS=true

# AI Project Analysis (server-only; never expose this key as VITE_*)
# Google Gemini via its OpenAI-compatible API and native audio transcription.
# Google AI Studio provides a free quota for development: https://aistudio.google.com/apikey
AI_PROVIDER=google
GOOGLE_AI_API_KEY=your-google-ai-api-key
AI_MODEL=gemini-3.6-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional separate model for voice transcription. Keep this on a Gemini model,
# even when AI_PROVIDER=xai is used for text and chat.
GOOGLE_TRANSCRIPTION_MODEL=gemini-3.6-flash

# xAI Grok via its OpenAI-compatible API
# AI_PROVIDER=xai
# XAI_API_KEY=your-xai-api-key
# AI_MODEL=grok-3-mini
# AI_BASE_URL=https://api.x.ai/v1

# --- Production hardening ---
# NODE_ENV=production requires a strong JWT_SECRET (startup fails otherwise)
# CORS_ORIGINS=https://app.example.com          # comma-separated; defaults to * in dev, BASE_URL in production
#   The same list also scopes the CSP frame-ancestors value that allows the
#   browser frontend to embed authenticated live-preview iframes.
# MAX_BODY_BYTES=26214400
# HELIX_ENABLE_DEMO=false                        # demo login (default: enabled outside production)
# AI_FALLBACK_PROVIDERS=openai,xai               # tried in order when the primary provider fails
# AI_MAX_RETRIES=2
# AI_TIMEOUT_MS=120000
# HELIX_MOCK_AI=false                            # force deterministic offline agents
# HELIX_ALLOW_MOCK_FALLBACK=false                # simulated output only when NO provider is configured (default: dev only)

# --- Persistence (PostgreSQL, recommended for production) ---
# DATABASE_URL=postgres://helix:password@db-host:5432/helix
# Migrations run transactionally on boot under an advisory lock; state hydrates
# and interrupted work is finalized BEFORE the listener opens. One API replica
# per database (a second instance is refused). See DEPLOYMENT.md.

# --- Operational controls ---
# Daily AI token budgets (provider-reported usage; mock output is free; 0 = unlimited).
# Spend persists in the database, so limits cannot be reset by rebooting.
# HELIX_USER_DAILY_TOKEN_LIMIT=2000000
# HELIX_PROJECT_DAILY_TOKEN_LIMIT=4000000
# Per-user AI-route rate limiting (workflow start, autonomous run, repair, analyze, voice).
# HELIX_AI_RATE_LIMIT_MAX=40
# HELIX_AI_RATE_LIMIT_WINDOW_MS=900000
# Per-project concurrent sandbox jobs (global cap: EXECUTION_MAX_CONCURRENT above).
# HELIX_MAX_ACTIVE_JOBS_PER_PROJECT=25
# Autonomous runs auto-approve human gates. Outside production this is allowed;
# in production the start is rejected with 403 AUTONOMOUS_APPROVAL_REQUIRED
# unless explicitly enabled here.
# HELIX_AUTONOMOUS_AUTO_APPROVE=false

# --- Sessions & previews ---
# Issue the helix_session httpOnly cookie (SameSite=Lax; Secure in production)
# alongside bearer tokens — pair with VITE_COOKIE_SESSIONS=true. Cookies are
# only set for origins allowed by CORS_ORIGINS.
# HELIX_COOKIE_SESSIONS=false
# Preview capability lifetime; expired previews stop their job and their token
# is rejected. Default: 24h.
# HELIX_PREVIEW_TTL_MS=86400000

# --- Observability ---
# JSON-lines logging on stdout with automatic secret redaction.
# HELIX_LOG_LEVEL=info                           # debug | info | warn | error

# --- Autonomous engineering ---
# The autonomous pipeline (POST /api/v1/projects/:id/pipeline/run) runs the
# nine-agent DAG (approval gates auto-approved and recorded), materializes the
# artifacts, then runs REAL sandboxed install/test/build jobs. A failed step is
# diagnosed by the configured provider, patched, and re-verified by rerunning
# the same command: "verified" means the rerun exited 0 — there is no other
# source of truth. Repairs drafted by the offline mock are always labelled
# simulated and never reported as verified provider repairs.
# Repair history and the last 10 autonomous run summaries are persisted per
# project and exposed as project memory at GET /api/v1/projects/:id/context.
# OPENAI_BASE_URL (or AI_BASE_URL for the active provider) points the real
# OpenAI-compatible transport at your gateway/self-hosted endpoint if needed.
